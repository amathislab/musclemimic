# SMPL-H / MANO body models. Licensed per-user from https://mano.is.tue.mpg.de - not
# redistributable. `get_smpl_model_path()` resolves this relative to the working
# directory, which is why the retargeting scripts must be run from the repo root.
# Leading slash is load-bearing: unanchored `smpl/` would also swallow loco_mujoco/smpl/.
/smpl/

# OmniRetarget sweep artifacts: run logs and aggregated tables are regenerated by
# scripts/terra/, and the caches themselves live under ~/.musclemimic/caches/.
scripts/terra/*.log
scripts/terra/*_summary.txt
